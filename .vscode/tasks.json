{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/Winning.Playwright.NUnit.EndToEndTests/Winning.Playwright.NUnit.EndToEndTests.csproj",
                "--logger",
                "console;verbosity=normal"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/tests/Winning.Playwright.NUnit.EndToEndTests/Winning.Playwright.NUnit.EndToEndTests.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/tests/Winning.Playwright.NUnit.EndToEndTests/Winning.Playwright.NUnit.EndToEndTests.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "test",
                "--project",
                "${workspaceFolder}/tests/Winning.Playwright.NUnit.EndToEndTests/Winning.Playwright.NUnit.EndToEndTests.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}