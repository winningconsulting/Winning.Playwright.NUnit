<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Winning.Playwright.NUnit</RootNamespace>
    <AssemblyName>Winning.Playwright.NUnit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Winning.Playwright.NUnit</PackageId>
    <Version>0.1.0</Version>
    <Title>Winning Playwright NUnit helpers</Title>
    <Description>Base test fixture and helpers for annotating Playwright screencasts and traces in NUnit (Arrange/Act/Assert overlays, failure overlay, WebM capture, trace ZIPs).</Description>
    <PackageTags>playwright;nunit;screencast;tracing;testing;e2e</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.59.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <!--<ProjectReference Include="..\..\..\playwright-dotnet\src\Playwright\Playwright.csproj" /> -->
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
